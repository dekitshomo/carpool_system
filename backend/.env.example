# Server Configuration
PORT=5000
JWT_SECRET=carpool_secret_jwt_key_2026_academic
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Email delivery provider: "google-apps-script" uses HTTPS (recommended for Render);
# "smtp" is available for local or other SMTP servers.
EMAIL_PROVIDER=smtp

# Google Apps Script Web App URL and shared secret (recommended for Render)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Gmail / Institutional SMTP configuration for local development
# To send real email via Gmail SMTP:
# 1. Go to https://myaccount.google.com/security
# 2. Turn on 2-Step Verification
# 3. Search "App Passwords" and create one named "Carpool"
# 4. Paste your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
