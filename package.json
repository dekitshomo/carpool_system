{
  "name": "student-carpool-system",
  "version": "1.0.0",
  "description": "Student Carpool System - Academic Prototype",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "node run_all.js",
    "dev": "node run_all.js",
    "start:all": "node run_all.js",
    "start:backend": "cd backend && node src/server.js",
    "start:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && node src/utils/seed.js",
    "test": "cd backend && node test_suite.js"
  },
  "keywords": [
    "carpool",
    "student",
    "ridesharing",
    "campus-transport"
  ],
  "author": "Antigravity Pair Programmer",
  "license": "ISC"
}
